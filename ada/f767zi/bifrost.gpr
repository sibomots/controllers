-- Ada port of Bifrost for the NUCLEO-F767ZI, with real Ravenscar tasking
-- (Main/LCD_Sink/UART_Sink -- see ../SOFTWARE.md) -- the tasking phase
-- ../f722ze-tiny/ was blocked on, per ../../HARDWARE.md. This is a
-- separate top-level tree from f722ze-tiny, not a board variant of it
-- (same reasoning samv71-tiny is its own tree rather than a board
-- variant of f722ze-tiny): the architecture here is different in kind,
-- not just in register addresses -- a protected-object UART driver with
-- a real interrupt attach instead of a hand-extended vector table, no
-- hand-written startup/Reset_Handler at all, and two application tasks
-- instead of one polled super-loop.
--
-- Like samv71_tiny.gpr, there is no Board_Kind scenario variable here --
-- this tree targets exactly one board, so there is no second board's
-- directory to structurally exclude.
--
-- Selecting "light-tasking-stm32f769disco" below pulls in, via that
-- runtime's own runtime.xml, *required* compiler switches (-mcpu/-mfpu/
-- -mfloat-abi) and *required* linker switches (runtime adalib path, and
-- -T pointing at the runtime's own bundled linker script) unconditionally
-- -- none of that is specified here, same as samv71_tiny.gpr's own
-- Compiler/Linker packages. See ../../HARDWARE.md for why this profile
-- (built for the STM32F769NI) is the right fit for F767ZI's STM32F767ZI,
-- and runtime-overrides/README.md for the one-time toolchain step this
-- board's actual 8MHz HSE requires before the runtime's own clock
-- bring-up (Setup_Pll) will compute the right PLL configuration.
project Bifrost is

   for Target use "arm-eabi";
   for Runtime ("Ada") use "light-tasking-stm32f769disco";

   -- "C" added for the network telemetry feature -- vendored HAL_ETH/
   -- CMSIS/lwIP C sources live under vendor/, plus a hand-written
   -- Ada/C glue layer in lowlevel/src. See vendor/placeholder.c's own
   -- comment: this Phase A addition exists to confirm mixed Ada/C
   -- linking against light-tasking-stm32f769disco actually works on
   -- this toolchain before any real vendored source is added.
   for Languages use ("Ada", "C");

   for Source_Dirs use
     ("app/src",
      "behavioral/src",
      "lowlevel/src",
      "vendor",
      -- CMSIS device header + generic Cortex-M7 core headers (flat
      -- include style, e.g. "stm32f767xx.h", "core_cm7.h" -- no
      -- subdirectory prefix, so each is its own Source_Dirs entry).
      "vendor/cmsis_f7/Include",
      "vendor/cmsis_f7/CMSIS/Include",
      -- HAL -- only the 7 modules this project's ETH/lwIP glue needs
      -- (see lowlevel/src/stm32f7xx_hal_conf.h's own comment for why
      -- HAL_FLASH/HAL_PWR/HAL_DMA are deliberately absent).
      "vendor/hal_f7/Inc",
      "vendor/hal_f7/Src",
      -- LAN8742A PHY driver (flat include style).
      "vendor/lan8742",
      -- lwIP: "src/include" is ONE non-recursive entry on purpose --
      -- it's the root that "#include \"lwip/pbuf.h\""-style paths
      -- resolve against; listing its subdirectories individually
      -- would break that resolution, not fix it. "core"/"core/ipv4"/
      -- "netif" are separate entries because those hold the actual
      -- .c files to compile, pruned to UDP/IPv4-only (no TCP/IPv6/PPP/
      -- 6LoWPAN/bridging -- see vendor/lwip's own pruned tree).
      "vendor/lwip/src/include",
      "vendor/lwip/src/core",
      "vendor/lwip/src/core/ipv4",
      "vendor/lwip/src/netif",
      -- lwIP's arch port headers ("arch/cc.h", "arch/sys_arch.h",
      -- included WITH that prefix from inside lwip/arch.h and
      -- lwip/sys.h) -- the Source_Dirs entry is the *parent* of
      -- arch/, not arch/ itself, so that prefixed include resolves.
      "vendor/lwip/system");

   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.adb");

   package Builder is
      -- Same renaming convention as f722ze-tiny/samv71-tiny: gprbuild's
      -- default output name follows the Main source file's base name
      -- ("main"), not the project name.
      for Executable ("main.adb") use "bifrost.elf";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-g",
         "-ffunction-sections",
         "-fdata-sections");

      -- Same accepted-risk rationale as samv71_tiny.gpr's own Compiler
      -- package: depending on Interfaces.STM32.* triggers GNAT's
      -- "internal GNAT unit"/"non-portable and version-dependent"
      -- warning. Scoped to exactly the files that touch it, not
      -- blanket-silenced -- see samv71_tiny.gpr for the full rationale,
      -- unchanged here beyond which files it applies to.
      for Switches ("bifrost-uart.adb") use
        Compiler'Default_Switches ("Ada") & ("-gnatwI");
      for Switches ("bifrost-lcd.adb") use
        Compiler'Default_Switches ("Ada") & ("-gnatwI");

      -- The runtime's own runtime.xml injects -mcpu/-mfpu/-mfloat-abi
      -- automatically for the Ada compiler (via Runtime ("Ada") above)
      -- -- that injection is scoped to Ada, not guaranteed for C, so
      -- it has to be stated explicitly here to match, or vendored C
      -- object code would target the wrong ABI and fail to link
      -- against (or silently mismatch) the Ada runtime's own objects.
      for Default_Switches ("C") use
        ("-mcpu=cortex-m7", "-mthumb", "-mfpu=fpv5-d16", "-mfloat-abi=hard",
         "-g", "-ffunction-sections", "-fdata-sections",
         -- CMSIS device-selection macro: tells stm32f7xx.h which
         -- device header to pull in (stm32f767xx.h). Standard CMSIS
         -- convention to pass this as a build-level -D, not hardcode
         -- it inside a vendored header.
         "-DSTM32F767xx",
         -- Confirmed on real hardware (CFSR UsageFault, UNALIGNED bit,
         -- on a plain word `ldr`): this Ada runtime has alignment-trap
         -- checking enabled, and GCC does not reliably generate
         -- alignment-safe code for every packed-struct field read in
         -- the vendored lwIP tree on this target/version -- confirmed
         -- in two separate spots (etharp.c's IP-address copy, then
         -- ip4.c's, both on the same Ethernet-header-induced 2-byte
         -- offset) with no reason to assume there aren't more, lurking
         -- in tcp.c/udp.c/etc. Patching individual call sites (done
         -- for the first one, via SMEMCPY's own override hook -- not
         -- reverted, since it's still correct) doesn't scale to a
         -- whole vendored tree. This flag tells GCC to never assume an
         -- access is aligned unless it can prove so, generating safe
         -- code everywhere this class of bug could otherwise hide.
         "-mno-unaligned-access");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use
        ("-Wl,--gc-sections",
         "-Wl,-Map," & Project'Project_Dir & "bin/bifrost.map");
   end Linker;

end Bifrost;
