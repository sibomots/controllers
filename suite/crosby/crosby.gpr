-- Blinks user LED LD1 with a busy-wait counter. No timer, no task, no
-- protected object, no interrupt. See DESIGN.md for the runtime
-- choice and its one known caveat.
project Crosby is

   for Target use "arm-eabi";
   for Runtime ("Ada") use "light-stm32f769disco";

   for Languages use ("Ada");

   for Source_Dirs use
     ("app/src",
      "lowlevel/src");

   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.adb");

   package Builder is
      for Executable ("main.adb") use "crosby.elf";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-g",
         "-ffunction-sections",
         "-fdata-sections");

      -- Interfaces.STM32.* is an internal GNAT unit; using it directly
      -- triggers a "non-portable" warning. Accepted and suppressed
      -- here, scoped to the one file that touches it.
      for Switches ("crosby-led.adb") use
        Compiler'Default_Switches ("Ada") & ("-gnatwI");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use
        ("-Wl,--gc-sections",
         "-Wl,-Map," & Project'Project_Dir & "bin/crosby.map");
   end Linker;

end Crosby;
